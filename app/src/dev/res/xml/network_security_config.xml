<?xml version="1.0" encoding="utf-8"?>
<!--
  Локальный стенд ходит по HTTP (прокси поднят с выключенным auto_https), а адрес его меняется:
  10.0.2.2 с эмулятора, произвольный LAN-IP с реального телефона. Перечислить такие хосты списком
  нельзя, поэтому cleartext здесь разрешён целиком — и только здесь: в prod-исходниках лежит
  одноимённый файл, где он запрещён.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
