<?xml version="1.0" encoding="utf-8"?>
<!--
  Refresh-токен живёт два месяца. Уехавший в облачный бэкап, он приезжает на другое устройство и
  даёт там живую сессию, поэтому весь перенос данных запрещён целиком, а не выборочно.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
