    <!--
      Число со словом после него — форма, зависящая от количества. В английском и русском «more» и
      «ещё» не склоняются, и все варианты здесь совпадают; объявлены они всё равно, потому что в
      следующем языке совпадать перестанут, а место, где это чинить, должно уже существовать.
    -->
    <plurals name="chat_progress_more">
        <item quantity="one">%1$s · %2$d more</item>
        <item quantity="other">%1$s · %2$d more</item>
    </plurals>
